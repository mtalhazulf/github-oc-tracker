# ---- GitHub access ----
# Fine-grained PAT (Contents: read, Metadata: read) or classic token with
# `repo` + `read:org`. Without a token you get 60 requests/hour and public
# repositories only.
GITHUB_TOKEN=

# GitHub Enterprise Server: point at your instance's REST API.
# GITHUB_API_URL=https://github.example.com/api/v3

# ---- Server ----
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/tracker.db

# ---- Background sync ----
# How often to re-discover org repositories and pull new commits. 0 disables.
SYNC_INTERVAL_MINUTES=30
# Parallel repo syncs (be gentle with the API).
SYNC_CONCURRENCY=2
# Safety cap on commits fetched per repo per sync run. 0 = unlimited.
MAX_COMMITS_PER_SYNC=10000
# When an org grows a new repository, start tracking it automatically.
AUTO_TRACK_NEW_REPOS=true
INCLUDE_FORKS=false
INCLUDE_ARCHIVED=true

# ---- Display ----
# Commit-time analytics timezone, minutes east of UTC (e.g. 300 for UTC+05:00,
# -420 for UTC-07:00). Applied to the hour/weekday/heatmap charts and dates.
TZ_OFFSET_MINUTES=0

# ---- Security ----
# Set both to require a login on every page (health check stays open).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ---- Logging ----
LOG_LEVEL=info
# json (production) or pretty (development)
LOG_FORMAT=pretty
